---
import { footer, nav, siteName } from '../../i18n/en';
import { url } from '../../utils/url';

const links = [
  { label: nav.home, href: url('/') },
  { label: nav.about, href: url('/about') },
  { label: nav.projects, href: url('/projects') },
  { label: nav.stories, href: url('/stories') },
  { label: nav.contact, href: url('/contact') },
];
---

<footer class="bg-[var(--color-surface)] border-t border-[var(--color-border)] mt-20">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <p class="font-heading text-lg font-bold text-[var(--color-text)] mb-2">{siteName}</p>
        <p class="text-sm font-semibold text-[var(--color-primary)] mb-3">{footer.tagline}</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{footer.summary}</p>
      </div>

      <!-- Nav links -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-3">
          {footer.sections.navigate}
        </p>
        <ul class="flex flex-col gap-2 list-none m-0 p-0">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Focus areas -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] mb-3">
          {footer.sections.focus}
        </p>
        <ul class="flex flex-col gap-2 list-none m-0 p-0">
          {footer.focusAreas.map((area) => (
            <li class="text-sm text-[var(--color-text-muted)]">{area}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-[var(--color-border)] flex flex-col md:flex-row justify-between gap-4">
      <p class="text-xs text-[var(--color-text-muted)]">{footer.copyright}</p>
      <p class="max-w-xl text-xs text-[var(--color-text-muted)] md:text-right">{footer.contactNote}</p>
    </div>
  </div>
</footer>
