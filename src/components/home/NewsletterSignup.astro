---
import { home } from '../../i18n/en';
import { url } from '../../utils/url';
---

<section class="py-20 bg-[var(--color-primary)]">
  <div class="max-w-2xl mx-auto px-4 text-center text-white">
    <h2 class="font-heading text-3xl md:text-4xl font-bold mb-3">{home.newsletter.heading}</h2>
    <p class="text-white/85 mb-8 leading-relaxed">{home.newsletter.subheading}</p>
    <a
      href={url('/contact')}
      class="inline-flex items-center justify-center px-8 py-4 rounded-md font-semibold bg-white text-[var(--color-primary)] hover:bg-[var(--color-surface)] transition-colors"
    >
      {home.newsletter.cta}
    </a>
    <p class="mt-4 text-xs text-white/70">{home.newsletter.disclaimer}</p>
  </div>
</section>
