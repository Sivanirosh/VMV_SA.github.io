---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import { contact } from '../i18n/en';
---

<BaseLayout title={contact.meta.title} description={contact.meta.description}>
  <section class="site-section pt-14 md:pt-20">
    <div class="site-container max-w-4xl text-center">
      <p class="eyebrow mb-6 justify-center">{contact.hero.heading}</p>
      <h1 class="text-balance font-heading text-5xl font-bold leading-tight text-[var(--color-text)] md:text-7xl">
        {contact.intro.heading}
      </h1>
      <p class="mx-auto mt-7 max-w-3xl text-xl leading-relaxed text-[var(--color-text-muted)]">
        {contact.hero.subheading}
      </p>
    </div>
  </section>

  <section class="site-section pt-0">
    <div class="site-container grid gap-8 lg:grid-cols-[0.92fr_1.08fr]">
      <article class="bg-[var(--color-deep)] p-8 text-white md:p-10">
        <h2 class="font-heading text-4xl font-bold leading-tight">{contact.intro.heading}</h2>
        <div class="mt-7 space-y-5">
          {contact.intro.paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed text-white/74">{paragraph}</p>
          ))}
        </div>
      </article>

      <article class="editorial-card p-8 md:p-10">
        <SectionHeader heading={contact.focus.heading} />
        <ul class="mt-8 grid gap-px bg-[var(--color-border)] sm:grid-cols-2">
          {contact.focus.items.map((item) => (
            <li class="bg-[var(--color-card)] p-5 text-[var(--color-text-muted)]">
              <span class="mb-4 block h-px w-10 bg-[var(--color-primary)]"></span>
              {item}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
