---
import BaseLayout from './BaseLayout.astro';
import { stories } from '../i18n/en';
import { url } from '../utils/url';

interface Props {
  name: string;
  age?: number;
  location: string;
  coverImage: string;
  quote: string;
  publishedDate: string;
}

const { name, age, location, coverImage, quote, publishedDate } = Astro.props;
const title = age ? `${name}, ${age}` : name;
---

<BaseLayout title={`${name} — ${stories.labels.titleSuffix}`} description={quote}>
  <section class="site-section pt-10 md:pt-16">
    <div class="site-container max-w-5xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-card)]">
      <img src={url(coverImage)} alt={name} class="aspect-[16/9] w-full object-cover" />
      <div class="p-8 md:p-10">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-primary-dark)]">
          {location} · {stories.labels.published} {publishedDate}
        </p>
        <h1 class="mt-4 text-balance font-heading text-4xl font-bold leading-tight text-[var(--color-text)] md:text-6xl">{title}</h1>
      </div>
    </div>
  </section>

  <article class="site-container max-w-3xl pb-24">
    <p class="border-l-4 border-[var(--color-primary)] pl-6 text-xl leading-relaxed text-[var(--color-text)] md:text-2xl">
      {quote}
    </p>

    <div class="prose mt-10 max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
