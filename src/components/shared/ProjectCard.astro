---
import { projects } from '../../i18n/en';
import { url } from '../../utils/url';

interface Props {
  slug: string;
  title: string;
  status: 'planned' | 'in-progress' | 'completed';
  location: string;
  coverImage: string;
  summary: string;
}

const { slug, title, status, location, coverImage, summary } = Astro.props;

const statusColors = {
  planned: 'bg-blue-100 text-blue-800',
  'in-progress': 'bg-amber-100 text-amber-800',
  completed: 'bg-green-100 text-green-800',
};
---

<a
  href={url(`/projects/${slug}`)}
  class="surface-card group block overflow-hidden rounded-[2rem] p-3 transition-transform duration-300 hover:-translate-y-1"
>
  <div class="aspect-[16/10] overflow-hidden rounded-[1.5rem]">
    <img
      src={url(coverImage)}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </div>
  <div class="p-4">
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider ${statusColors[status]}`}>
        {projects.statusLabels[status]}
      </span>
      <span class="text-xs font-semibold text-[var(--color-text-muted)]">{location}</span>
    </div>
    <h3 class="font-heading text-2xl font-bold leading-tight text-[var(--color-text)] transition-colors group-hover:text-[var(--color-primary)]">
      {title}
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{summary}</p>
  </div>
</a>
