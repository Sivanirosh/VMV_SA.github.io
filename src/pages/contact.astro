---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import { contact } from '../i18n/en';
---

<BaseLayout title={contact.meta.title} description={contact.meta.description}>
  <!-- Hero -->
  <section class="py-20 bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">
        {contact.hero.heading}
      </h1>
      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{contact.hero.subheading}</p>
    </div>
  </section>

  <!-- Contact guidance -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12">
      <div>
        <SectionHeader heading={contact.intro.heading} />
        <div class="space-y-5">
          {contact.intro.paragraphs.map((paragraph) => (
            <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{paragraph}</p>
          ))}
        </div>
      </div>

      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 md:p-8">
        <h2 class="font-heading text-2xl font-bold text-[var(--color-text)] mb-6">
          {contact.focus.heading}
        </h2>
        <ul class="space-y-3">
          {contact.focus.items.map((item) => (
            <li class="flex gap-3 text-[var(--color-text-muted)]">
              <span class="mt-1 h-2 w-2 rounded-full bg-[var(--color-primary)] shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
