---
import { home } from '../../i18n/en';

const stats = home.impact.stats;
---

<section class="bg-[var(--color-deep)] px-4 py-20 text-white md:py-28">
  <div class="site-container grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
    <div>
      <p class="eyebrow mb-6 text-[#E9CDB6]">{home.impact.kicker}</p>
      <h2 class="text-balance font-heading text-4xl font-bold leading-tight md:text-6xl">
        {home.impact.heading}
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/72">
        {home.impact.subheading}
      </p>
    </div>

    <div class="grid grid-cols-2 gap-px bg-white/16">
      {stats.map((stat) => (
        <div class="bg-[var(--color-deep)] p-5 md:p-7">
          <p class="font-heading text-4xl font-bold text-[#E9CDB6] md:text-5xl">{stat.value}</p>
          <p class="mt-3 text-sm font-bold uppercase tracking-wider text-white">{stat.label}</p>
          <p class="mt-2 text-sm text-white/62">{stat.helper}</p>
        </div>
      ))}
    </div>
  </div>
</section>
