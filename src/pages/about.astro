---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import { about, images } from '../i18n/en';
import { url } from '../utils/url';
---

<BaseLayout title={about.meta.title} description={about.meta.description}>
  <section class="site-section pt-14 md:pt-20">
    <div class="site-container grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <p class="eyebrow mb-6">{about.hero.eyebrow}</p>
        <h1 class="text-balance font-heading text-5xl font-bold leading-tight text-[var(--color-text)] md:text-7xl">
          {about.hero.heading}
        </h1>
        <p class="mt-7 max-w-2xl text-xl leading-relaxed text-[var(--color-text-muted)]">
          {about.hero.subheading}
        </p>
      </div>
      <div class="photo-frame p-2">
        <img src={url(images.aboutTeam)} alt={images.aboutTeamAlt} class="aspect-[4/3] w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="site-section pt-0">
    <div class="site-container grid gap-8 lg:grid-cols-2">
      <article class="editorial-card p-8 md:p-10">
        <SectionHeader heading={about.mission.heading} />
        <div class="mt-8 space-y-5">
          {about.mission.paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed text-[var(--color-text-muted)]">{paragraph}</p>
          ))}
        </div>
      </article>

      <article class="bg-[var(--color-deep)] p-8 text-white md:p-10">
        <h2 class="font-heading text-4xl font-bold leading-tight">{about.origin.heading}</h2>
        <div class="mt-7 space-y-5">
          {about.origin.paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed text-white/74">{paragraph}</p>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section class="site-section bg-[rgba(243,233,218,0.55)]">
    <div class="site-container">
      <SectionHeader heading={about.values.heading} centered />
      <div class="mt-12 grid grid-cols-1 gap-px bg-[var(--color-border)] md:grid-cols-3">
        {about.values.items.map((item) => (
          <article class="bg-[var(--color-card)] p-8 text-center">
            <p class="mx-auto mb-5 flex h-14 w-14 items-center justify-center border border-[var(--color-primary)] font-heading text-2xl font-bold text-[var(--color-primary-dark)]">
              {item.letter}
            </p>
            <h3 class="font-heading text-2xl font-bold text-[var(--color-text)]">{item.word}</h3>
            <p class="mt-2 text-[var(--color-text-muted)]">{item.meaning}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container grid overflow-hidden border border-[var(--color-border)] bg-[var(--color-card)] lg:grid-cols-[0.92fr_1.08fr]">
      <div class="p-8 md:p-12">
        <SectionHeader heading={about.centre.heading} />
        <div class="mt-8 space-y-5">
          {about.centre.paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed text-[var(--color-text-muted)]">{paragraph}</p>
          ))}
        </div>
      </div>
      <img src={url(images.projectCover)} alt={images.projectCoverAlt} class="h-full min-h-96 w-full object-cover" />
    </div>
  </section>

  <section class="site-section pt-0">
    <div class="site-container">
      <SectionHeader heading={about.milestones.heading} centered />
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {about.milestones.items.map((item) => (
          <article class="quiet-card border-l-4 border-l-[var(--color-primary)] p-7">
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-primary-dark)]">{item.year}</p>
            <h3 class="mt-4 font-heading text-2xl font-bold text-[var(--color-text)]">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-[var(--color-text-muted)]">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section bg-[var(--color-card)]">
    <div class="site-container">
      <SectionHeader heading={about.leadership.heading} />
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        {about.leadership.members.map((member) => (
          <article class="border-t border-[var(--color-border)] pt-6">
            <p class="font-heading text-2xl font-bold text-[var(--color-text)]">{member.name}</p>
            <p class="mt-2 text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-primary-dark)]">{member.role}</p>
            <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">{member.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
