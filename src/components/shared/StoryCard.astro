---
interface Props {
  slug: string;
  name: string;
  age?: number;
  location: string;
  coverImage: string;
  quote: string;
}

import { url } from '../../utils/url';
const { slug, name, age, location, coverImage, quote } = Astro.props;
const title = age ? `${name}, ${age}` : name;
---

<a
  href={url(`/stories/${slug}`)}
  class="group block rounded-xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-bg)] hover:shadow-md transition-shadow"
>
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={url(coverImage)}
      alt={name}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
  </div>
  <div class="p-5">
    <p class="text-xs text-[var(--color-text-muted)] mb-2">{location}</p>
    <h3 class="font-heading text-lg font-bold text-[var(--color-text)] mb-3 group-hover:text-[var(--color-primary)] transition-colors">
      {title}
    </h3>
    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{quote}</p>
  </div>
</a>
