---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import { about, images } from '../i18n/en';
import { url } from '../utils/url';
---

<BaseLayout title={about.meta.title} description={about.meta.description}>
  <!-- Hero -->
  <section class="relative py-24 bg-[var(--color-surface)] overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="font-heading text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">
          {about.hero.heading}
        </h1>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{about.hero.subheading}</p>
      </div>
      <div class="rounded-xl overflow-hidden aspect-[4/3] border border-[var(--color-border)] shadow-sm">
        <img src={url(images.aboutTeam)} alt={images.aboutTeamAlt} class="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4">
      <SectionHeader heading={about.mission.heading} />
      <div class="space-y-5">
        {about.mission.paragraphs.map((paragraph) => (
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Origin story -->
  <section class="py-20 bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-4">
      <SectionHeader heading={about.origin.heading} />
      <div class="space-y-5">
        {about.origin.paragraphs.map((paragraph) => (
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-4">
      <SectionHeader heading={about.values.heading} centered />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {about.values.items.map((item) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-center">
            <p class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-primary)] font-heading text-2xl font-bold text-white">
              {item.letter}
            </p>
            <h3 class="font-heading text-xl font-bold text-[var(--color-text)] mb-2">{item.word}</h3>
            <p class="text-[var(--color-text-muted)]">{item.meaning}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Centre today -->
  <section class="py-20 bg-[var(--color-surface)]">
    <div class="max-w-3xl mx-auto px-4">
      <SectionHeader heading={about.centre.heading} />
      <div class="space-y-5">
        {about.centre.paragraphs.map((paragraph) => (
          <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Milestones -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-4">
      <SectionHeader heading={about.milestones.heading} centered />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {about.milestones.items.map((item) => (
          <article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 shadow-sm">
            <p class="text-sm font-semibold text-[var(--color-primary)] mb-2">{item.year}</p>
            <h3 class="font-heading text-xl font-bold text-[var(--color-text)] mb-2">{item.title}</h3>
            <p class="text-[var(--color-text-muted)] leading-relaxed">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="py-20 bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <SectionHeader heading={about.leadership.heading} />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {about.leadership.members.map((member) => (
          <div class="p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)]">
            <p class="font-heading font-bold text-lg text-[var(--color-text)]">{member.name}</p>
            <p class="text-sm text-[var(--color-primary)] font-semibold mb-2">{member.role}</p>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
