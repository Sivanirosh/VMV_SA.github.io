---
import { home } from '../../i18n/en';

const stats = home.impact.stats;
---

<section class="bg-[var(--color-primary)] text-white py-16 md:py-20">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
        {home.impact.heading}
      </h2>
      <p class="text-white/85 leading-relaxed">{home.impact.subheading}</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 text-center">
      {stats.map((stat) => (
        <div class="rounded-xl border border-white/20 bg-white/10 p-5 md:p-6 backdrop-blur-sm">
          <p class="font-heading text-4xl md:text-5xl font-bold mb-2">{stat.value}</p>
          <p class="text-sm md:text-base text-white uppercase tracking-wider font-semibold">{stat.label}</p>
          <p class="mt-2 text-xs md:text-sm text-white/75">{stat.helper}</p>
        </div>
      ))}
    </div>
  </div>
</section>
