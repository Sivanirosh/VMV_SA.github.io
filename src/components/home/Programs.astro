---
import SectionHeader from '../shared/SectionHeader.astro';
import { home } from '../../i18n/en';

const programs = home.programs.items;
---

<section class="site-section bg-[rgba(243,233,218,0.55)]">
  <div class="site-container">
    <SectionHeader heading={home.programs.heading} subheading={home.programs.subheading} centered />

    <div class="mt-12 grid grid-cols-1 gap-px bg-[var(--color-border)] md:grid-cols-2 lg:grid-cols-4">
      {programs.map((program) => (
        <article class="bg-[var(--color-card)] p-7 md:p-8">
          <div class="mb-8 text-3xl" aria-hidden="true">{program.icon}</div>
          <h3 class="font-heading text-2xl font-bold leading-tight text-[var(--color-text)]">
            {program.title}
          </h3>
          <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">
            {program.body}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
