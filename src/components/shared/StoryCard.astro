---
interface Props {
  slug: string;
  name: string;
  age?: number;
  location: string;
  coverImage: string;
  quote: string;
}

import { url } from '../../utils/url';
const { slug, name, age, location, coverImage, quote } = Astro.props;
const title = age ? `${name}, ${age}` : name;
---

<a
  href={url(`/stories/${slug}`)}
  class="surface-card group block overflow-hidden rounded-[2rem] p-3 transition-transform duration-300 hover:-translate-y-1"
>
  <div class="aspect-[4/3] overflow-hidden rounded-[1.5rem]">
    <img
      src={url(coverImage)}
      alt={name}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </div>
  <div class="p-4">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">{location}</p>
    <h3 class="font-heading text-2xl font-bold leading-tight text-[var(--color-text)] transition-colors group-hover:text-[var(--color-primary)]">
      {title}
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{quote}</p>
  </div>
</a>
