---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/shared/ProjectCard.astro';
import SectionHeader from '../../components/shared/SectionHeader.astro';
import { projects as projectsStrings } from '../../i18n/en';

const allProjects = await getCollection('projects');
---

<BaseLayout title={projectsStrings.meta.title} description={projectsStrings.meta.description}>
  <section class="px-4 py-24 md:py-32">
    <div class="mx-auto max-w-6xl">
      <SectionHeader
        heading={projectsStrings.heading}
        subheading={projectsStrings.subheading}
        centered
      />
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {allProjects.map((project) => (
          <ProjectCard
            slug={project.slug}
            title={project.data.title}
            status={project.data.status}
            location={project.data.location}
            coverImage={project.data.coverImage}
            summary={project.data.summary}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
