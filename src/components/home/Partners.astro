---
import { home } from '../../i18n/en';
---

<section class="py-16 border-y border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="max-w-5xl mx-auto px-4 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--color-primary)] mb-4">
      {home.partners.heading}
    </p>
    <p class="max-w-3xl mx-auto text-lg text-[var(--color-text-muted)] leading-relaxed mb-8">
      {home.partners.subheading}
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      {home.partners.supporters.map((supporter) => (
        <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-semibold text-[var(--color-text)]">
          {supporter}
        </span>
      ))}
    </div>
  </div>
</section>
