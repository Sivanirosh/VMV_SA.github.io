---
import { getCollection } from 'astro:content';
import SectionHeader from '../shared/SectionHeader.astro';
import { home, projects as projectStrings } from '../../i18n/en';
import { url } from '../../utils/url';

const allProjects = await getCollection('projects');
const current = allProjects.find((p) => p.data.status === 'in-progress');
---

{current && (
  <section class="site-section">
    <div class="site-container">
      <SectionHeader heading={home.currentProject.heading} />

      <a href={url(`/projects/${current.slug}`)} class="editorial-card group mt-10 grid overflow-hidden md:grid-cols-[1.05fr_.95fr]">
        <div class="overflow-hidden">
          <img
            src={url(current.data.coverImage)}
            alt={current.data.title}
            class="h-full min-h-[22rem] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </div>

        <div class="flex flex-col justify-between p-7 md:p-10">
          <div>
            <div class="mb-6 flex flex-wrap items-center gap-3">
              <span class="bg-[var(--color-surface)] px-3 py-1 text-xs font-bold uppercase tracking-wider text-[var(--color-primary-dark)]">
                {projectStrings.statusLabels[current.data.status]}
              </span>
              <span class="text-sm font-semibold text-[var(--color-text-muted)]">{current.data.location}</span>
            </div>
            <h3 class="font-heading text-3xl font-bold leading-tight text-[var(--color-text)] md:text-5xl">
              {current.data.title}
            </h3>
            <p class="mt-5 text-lg leading-relaxed text-[var(--color-text-muted)]">
              {current.data.summary}
            </p>
          </div>

          <div class="mt-9 grid grid-cols-3 border-y border-[var(--color-border)]">
            <div class="py-5 pr-4">
              <p class="font-heading text-3xl font-bold text-[var(--color-primary-dark)]">{current.data.stats.studentsServed}</p>
              <p class="text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">{projectStrings.labels.studentsServed}</p>
            </div>
            <div class="border-x border-[var(--color-border)] px-4 py-5">
              <p class="font-heading text-3xl font-bold text-[var(--color-primary-dark)]">{current.data.stats.classroomsBuilt}</p>
              <p class="text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">{projectStrings.labels.classroomsBuilt}</p>
            </div>
            <div class="py-5 pl-4">
              <p class="font-heading text-3xl font-bold text-[var(--color-primary-dark)]">{current.data.stats.volunteersInvolved}</p>
              <p class="text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">{projectStrings.labels.volunteersInvolved}</p>
            </div>
          </div>

          <p class="mt-8 font-bold text-[var(--color-primary-dark)] group-hover:underline">
            {home.currentProject.linkLabel} →
          </p>
        </div>
      </a>
    </div>
  </section>
)}
