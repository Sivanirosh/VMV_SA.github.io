---
import BaseLayout from './BaseLayout.astro';
import { projects as projectsStrings } from '../i18n/en';
import { url } from '../utils/url';

interface Props {
  title: string;
  status: 'planned' | 'in-progress' | 'completed';
  location: string;
  startDate: string;
  completedDate?: string;
  coverImage: string;
  stats: {
    studentsServed: number;
    classroomsBuilt: number;
    volunteersInvolved: number;
  };
  summary: string;
}

const { title, status, location, startDate, completedDate, coverImage, stats, summary } = Astro.props;

const statusColors = {
  planned: 'bg-blue-100 text-blue-800',
  'in-progress': 'bg-amber-100 text-amber-800',
  completed: 'bg-green-100 text-green-800',
};
---

<BaseLayout title={`${title} — ${projectsStrings.heading}`} description={summary}>
  <section class="site-section pt-10 md:pt-16">
    <div class="site-container grid overflow-hidden border border-[var(--color-border)] bg-[var(--color-card)] lg:grid-cols-[0.95fr_1.05fr]">
      <div class="overflow-hidden">
        <img src={url(coverImage)} alt={title} class="h-full min-h-[24rem] w-full object-cover" />
      </div>

      <div class="p-8 md:p-12">
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span class={`px-3 py-1 text-xs font-bold uppercase tracking-wider ${statusColors[status]}`}>
            {projectsStrings.statusLabels[status]}
          </span>
          <span class="text-sm font-semibold text-[var(--color-text-muted)]">{location}</span>
        </div>
        <h1 class="text-balance font-heading text-5xl font-bold leading-tight text-[var(--color-text)] md:text-7xl">{title}</h1>
        <p class="mt-6 text-xl leading-relaxed text-[var(--color-text-muted)]">{summary}</p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm text-[var(--color-text-muted)]">
          <span>{projectsStrings.labels.started} {startDate}</span>
          {completedDate && <span>{projectsStrings.labels.completed} {completedDate}</span>}
        </div>
      </div>
    </div>
  </section>

  <article class="site-container max-w-4xl pb-24">
    <div class="mb-12 grid grid-cols-3 border-y border-[var(--color-border)]">
      <div class="py-6 pr-4 text-center">
        <p class="font-heading text-3xl font-bold text-[var(--color-primary-dark)] md:text-4xl">{stats.studentsServed}</p>
        <p class="mt-1 text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">{projectsStrings.labels.studentsServed}</p>
      </div>
      <div class="border-x border-[var(--color-border)] px-4 py-6 text-center">
        <p class="font-heading text-3xl font-bold text-[var(--color-primary-dark)] md:text-4xl">{stats.classroomsBuilt}</p>
        <p class="mt-1 text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">{projectsStrings.labels.classroomsBuilt}</p>
      </div>
      <div class="py-6 pl-4 text-center">
        <p class="font-heading text-3xl font-bold text-[var(--color-primary-dark)] md:text-4xl">{stats.volunteersInvolved}</p>
        <p class="mt-1 text-xs font-bold uppercase tracking-wide text-[var(--color-text-muted)]">{projectsStrings.labels.volunteersInvolved}</p>
      </div>
    </div>

    <div class="prose max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
