---
import BaseLayout from './BaseLayout.astro';
import { stories } from '../i18n/en';
import { url } from '../utils/url';

interface Props {
  name: string;
  age?: number;
  location: string;
  coverImage: string;
  quote: string;
  publishedDate: string;
}

const { name, age, location, coverImage, quote, publishedDate } = Astro.props;
const title = age ? `${name}, ${age}` : name;
---

<BaseLayout title={`${name} — ${stories.labels.titleSuffix}`} description={quote}>
  <section class="px-4 py-10 md:py-16">
    <div class="surface-card mx-auto max-w-5xl overflow-hidden rounded-[2.5rem] p-3">
      <div class="relative overflow-hidden rounded-[2rem]">
        <img src={url(coverImage)} alt={name} class="aspect-[16/9] w-full object-cover" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/78 to-transparent p-6 text-white md:p-10">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-white/70">
            {location} · {stories.labels.published} {publishedDate}
          </p>
          <h1 class="mt-3 font-heading text-4xl font-bold leading-tight md:text-6xl">{title}</h1>
        </div>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <p class="surface-card rounded-[2rem] p-6 text-xl leading-relaxed text-[var(--color-text)] md:p-8 md:text-2xl">
      {quote}
    </p>

    <div class="prose mt-10 max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
