---
import { home } from '../../i18n/en';
---

<section class="px-4 py-24">
  <div class="surface-card mx-auto grid max-w-6xl overflow-hidden rounded-[2.5rem] md:grid-cols-[0.9fr_1.1fr]">
    <div class="p-8 md:p-12">
      <p class="kicker mb-5">{home.partners.heading}</p>
      <p class="font-heading text-3xl font-bold leading-tight text-[var(--color-text)] md:text-5xl">
        {home.partners.subheading}
      </p>
    </div>
    <div class="relative min-h-80 overflow-hidden bg-[var(--color-surface)] p-8 md:p-12">
      <div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full border border-[rgba(196,92,46,0.24)]"></div>
      <div class="absolute left-1/2 top-1/2 h-40 w-40 -translate-x-1/2 -translate-y-1/2 rounded-full border border-[rgba(101,84,242,0.20)]"></div>
      <div class="relative grid h-full grid-cols-2 gap-4">
        {home.partners.supporters.map((supporter, index) => (
          <div class={`rounded-[1.5rem] border border-[var(--color-border)] bg-white/75 p-5 shadow-sm backdrop-blur ${index % 2 === 0 ? 'self-start' : 'self-end'}`}>
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">0{index + 1}</p>
            <p class="mt-3 font-heading text-xl font-bold text-[var(--color-text)]">{supporter}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
