---
import { home } from '../../i18n/en';
import { url } from '../../utils/url';
---

<section class="site-section">
  <div class="site-container bg-[var(--color-primary-dark)] px-6 py-14 text-center text-white md:px-12 md:py-20">
    <p class="eyebrow mb-6 justify-center text-[#F0D7C4]">{home.newsletter.heading}</p>
    <h2 class="mx-auto max-w-3xl text-balance font-heading text-4xl font-bold leading-tight md:text-6xl">
      {home.newsletter.subheading}
    </h2>
    <a href={url('/contact')} class="mt-9 inline-flex rounded-sm bg-white px-6 py-4 font-bold text-[var(--color-primary-dark)] transition-colors hover:bg-[#F7EBDD]">
      {home.newsletter.cta}
    </a>
    <p class="mt-5 text-sm text-white/68">{home.newsletter.disclaimer}</p>
  </div>
</section>
