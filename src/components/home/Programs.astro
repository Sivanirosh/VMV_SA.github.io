---
import SectionHeader from '../shared/SectionHeader.astro';
import { home } from '../../i18n/en';

const programs = home.programs.items;
---

<section class="py-20 bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-4">
    <SectionHeader heading={home.programs.heading} subheading={home.programs.subheading} centered />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-4">
      {programs.map((program) => (
        <div class="bg-[var(--color-bg)] rounded-xl p-7 border border-[var(--color-border)] shadow-sm">
          <div class="text-4xl mb-4" aria-hidden="true">{program.icon}</div>
          <h3 class="font-heading text-xl font-bold text-[var(--color-text)] mb-3">{program.title}</h3>
          <p class="text-[var(--color-text-muted)] leading-relaxed">{program.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
