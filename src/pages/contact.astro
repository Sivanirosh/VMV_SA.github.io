---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import { contact } from '../i18n/en';
---

<BaseLayout title={contact.meta.title} description={contact.meta.description}>
  <section class="relative isolate overflow-hidden px-4 py-24 md:py-32">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_30%_20%,rgba(196,92,46,0.18),transparent_34%),radial-gradient(circle_at_75%_5%,rgba(101,84,242,0.12),transparent_30%)]"></div>
    <div class="mx-auto max-w-4xl text-center">
      <p class="kicker mx-auto mb-6">{contact.hero.heading}</p>
      <h1 class="gradient-text font-heading text-5xl font-bold leading-[0.98] md:text-7xl">
        {contact.intro.heading}
      </h1>
      <p class="mx-auto mt-7 max-w-3xl text-xl leading-relaxed text-[var(--color-text-muted)]">
        {contact.hero.subheading}
      </p>
    </div>
  </section>

  <section class="px-4 py-20">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[0.92fr_1.08fr]">
      <article class="aurora-panel rounded-[2.5rem] p-8 text-white shadow-2xl md:p-12">
        <h2 class="font-heading text-4xl font-bold leading-tight md:text-5xl">{contact.intro.heading}</h2>
        <div class="mt-7 space-y-5">
          {contact.intro.paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed text-white/78">{paragraph}</p>
          ))}
        </div>
      </article>

      <article class="surface-card rounded-[2.5rem] p-8 md:p-12">
        <SectionHeader heading={contact.focus.heading} />
        <ul class="grid gap-3 sm:grid-cols-2">
          {contact.focus.items.map((item) => (
            <li class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-[var(--color-text-muted)]">
              <span class="mb-3 block h-2 w-8 rounded-full bg-[var(--color-primary)]"></span>
              {item}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
