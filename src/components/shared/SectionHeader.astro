---
import { sectionKicker } from '../../i18n/en';

interface Props {
  heading: string;
  subheading?: string;
  centered?: boolean;
}

const { heading, subheading, centered = false } = Astro.props;
---

<div class={`${centered ? 'mx-auto max-w-3xl text-center' : ''}`}>
  <p class={`eyebrow mb-5 ${centered ? 'justify-center' : ''}`}>{sectionKicker}</p>
  <h2 class="text-balance font-heading text-4xl font-bold leading-tight text-[var(--color-text)] md:text-5xl">
    {heading}
  </h2>
  {subheading && (
    <p class={`mt-5 text-lg leading-relaxed text-[var(--color-text-muted)] md:text-xl ${centered ? 'mx-auto max-w-3xl' : 'max-w-2xl'}`}>
      {subheading}
    </p>
  )}
</div>
