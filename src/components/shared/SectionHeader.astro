---
import { sectionKicker } from '../../i18n/en';

interface Props {
  heading: string;
  subheading?: string;
  centered?: boolean;
}

const { heading, subheading, centered = false } = Astro.props;
---

<div class={`mb-12 ${centered ? 'mx-auto text-center' : ''}`}>
  <p class={`kicker mb-4 ${centered ? 'mx-auto' : ''}`}>{sectionKicker}</p>
  <h2 class="gradient-text font-heading text-4xl font-bold leading-[1.02] md:text-5xl">
    {heading}
  </h2>
  {subheading && (
    <p class={`mt-5 text-lg text-[var(--color-text-muted)] leading-relaxed md:text-xl ${centered ? 'mx-auto max-w-3xl' : 'max-w-2xl'}`}>
      {subheading}
    </p>
  )}
</div>
