---
import { footer, nav, siteName, images } from '../../i18n/en';
import { url } from '../../utils/url';

const links = [
  { label: nav.home, href: url('/') },
  { label: nav.about, href: url('/about') },
  { label: nav.projects, href: url('/projects') },
  { label: nav.stories, href: url('/stories') },
  { label: nav.contact, href: url('/contact') },
];
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-card)] px-4 py-14">
  <div class="site-container">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.25fr_.75fr_.75fr]">
      <div>
        <img src={url(images.logoMain)} alt={images.logoAlt} class="mb-5 h-11 w-auto" />
        <p class="font-heading text-2xl font-bold text-[var(--color-text)]">{siteName}</p>
        <p class="mt-3 max-w-md text-sm font-bold uppercase tracking-[0.14em] text-[var(--color-primary-dark)]">{footer.tagline}</p>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-[var(--color-text-muted)]">{footer.summary}</p>
      </div>

      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
          {footer.sections.navigate}
        </p>
        <ul class="flex flex-col gap-3 list-none m-0 p-0">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-sm font-semibold text-[var(--color-text-muted)] hover:text-[var(--color-primary-dark)] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
          {footer.sections.focus}
        </p>
        <ul class="flex flex-col gap-3 list-none m-0 p-0">
          {footer.focusAreas.map((area) => (
            <li class="text-sm font-semibold text-[var(--color-text-muted)]">{area}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-[var(--color-border)] pt-6 md:flex-row md:items-center md:justify-between">
      <p class="text-xs text-[var(--color-text-muted)]">{footer.copyright}</p>
      <p class="max-w-xl text-xs leading-relaxed text-[var(--color-text-muted)] md:text-right">{footer.contactNote}</p>
    </div>
  </div>
</footer>
